DATABASE_URL=postgresql+asyncpg://showtrack:showtrack@localhost:5432/showtrack
LOG_LEVEL=INFO
ENVIRONMENT=local
SECRET_KEY=change-me-use-openssl-rand-hex-32
REGISTRATION_CODE=change-me

# Optional. Without it, media search returns AniList (anime) results only.
TMDB_API_KEY=

# --- Background sync (all optional; the defaults below are what the app uses) ---
# Set false to run a second replica with the API but no scheduler. See the README.
SYNC_ENABLED=true
# How often the airing-refresh job WAKES UP. It does not refresh every title on every run: each
# title has its own cadence based on how close its next episode is (SYNC_TIERS in
# app/sync/service.py — 1h when airing within 48 hours, 6h within a week, 24h beyond). Raising
# this above the tightest tier widens every tier to this value.
SYNC_INTERVAL_HOURS=1
# How often notification thresholds are evaluated. This makes NO provider calls, so it can be far
# more frequent than the sync above — it sets how precise "airs in 24 hours" actually is.
THRESHOLD_SCAN_MINUTES=15
# Lead time for the "airing soon" notification.
NOTIFY_SOON_HOURS=6
