DATABASE_URL=postgresql+asyncpg://showtrack:showtrack@localhost:5432/showtrack
LOG_LEVEL=INFO
ENVIRONMENT=local
SECRET_KEY=change-me-use-openssl-rand-hex-32
REGISTRATION_CODE=change-me

# Optional. Without it, media search returns AniList (anime) results only.
TMDB_API_KEY=

# --- Background sync (all optional; the defaults below are what the app uses) ---
# Set false to run a second replica with the API but no scheduler. See the README.
SYNC_ENABLED=true
# How often the airing-refresh job WAKES UP. It does not refresh every title on every run: each
# title has its own cadence based on how close its next episode is (SYNC_TIERS in
# app/sync/service.py — 1h when airing within 48 hours, 6h within a week, 24h beyond). Raising
# this above the tightest tier widens every tier to this value.
SYNC_INTERVAL_HOURS=1
# How often notification thresholds are evaluated. This makes NO provider calls, so it can be far
# more frequent than the sync above — it sets how precise "airs in 24 hours" actually is.
THRESHOLD_SCAN_MINUTES=15
# Lead time for the "airing soon" notification.
NOTIFY_SOON_HOURS=6

# --- Notifications (all optional) ---
# Base URL of the ntfy server that delivers pushes; must include a scheme. UNSET disables
# notifications entirely: no transport is built, the dispatch job is never registered, and tasks
# queue harmlessly as `pending` until it is set. http://localhost:8080 matches the ntfy service in
# docker-compose.yml when uvicorn runs on the host.
NTFY_BASE_URL=
# A CREDENTIAL — never commit a real value. Optional to the app, but REQUIRED in practice with the
# compose ntfy service, which runs NTFY_AUTH_DEFAULT_ACCESS=deny-all: without a token the server
# rejects the backend's own publishes with 403 and every notification retries until it fails. Mint
# one with `ntfy user add` + `ntfy token add` — see the README's Notifications section.
NTFY_TOKEN=
# How often the queue is drained. Database-only when empty, which is nearly always; its latency
# adds to the threshold scan's 15-minute granularity, so keeping it at 1 costs almost nothing.
NOTIFICATION_DISPATCH_MINUTES=1
