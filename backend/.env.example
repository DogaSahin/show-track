# Read by the APP when it runs on the host (uvicorn, alembic, pytest). A container does NOT use
# this line: docker-compose.yml builds its own URL against the `db` service, interpolating only
# POSTGRES_PASSWORD below. The two must therefore agree on the password and nothing else.
DATABASE_URL=postgresql+asyncpg://showtrack:showtrack@localhost:5432/showtrack

# Read by COMPOSE, not by the app: it is the password Postgres is created with and the one the
# api container's own DATABASE_URL is built from. Compose refuses to start without it.
#
# `showtrack` matches the DATABASE_URL above so host-run alembic and pytest keep working out of
# the box. CHANGE IT ON A REAL DEPLOYMENT — and change it before the first `up`, because Postgres
# only reads POSTGRES_PASSWORD when it initialises an empty data directory; setting it later
# leaves the old password in the existing volume and the api unable to connect.
POSTGRES_PASSWORD=showtrack

LOG_LEVEL=INFO
# Defaults to `production` in docker-compose.yml; docker-compose.override.yml sets it back to
# `local` for development, which is why this line is only read by host-run processes.
ENVIRONMENT=local

# A CREDENTIAL. Signs every access and refresh token, so anyone holding it can mint a session as
# any user. Compose refuses to start without it. `openssl rand -hex 32`.
SECRET_KEY=change-me-use-openssl-rand-hex-32
# The server-wide bootstrap code. NOT the only way to get an account since Phase 7.5a: a group's
# invite code registers one too, and joins that group in the same request. Keep it to 64
# characters or fewer — the register endpoint caps the field there, the same bound the group-join
# endpoint uses. `openssl rand -hex 32` fits exactly. A CREDENTIAL: it is the only thing standing
# between a stranger who can reach your server and an account on it. Compose refuses to start
# without it.
REGISTRATION_CODE=change-me

# Optional. Without it, media search returns AniList (anime) results only.
TMDB_API_KEY=

# --- Background sync (all optional; the defaults below are what the app uses) ---
# Set false to run a second replica with the API but no scheduler. See the README.
SYNC_ENABLED=true
# How often the airing-refresh job WAKES UP. It does not refresh every title on every run: each
# title has its own cadence based on how close its next episode is (SYNC_TIERS in
# app/sync/service.py — 1h when airing within 48 hours, 6h within a week, 24h beyond). Raising
# this above the tightest tier widens every tier to this value.
SYNC_INTERVAL_HOURS=1

# --- Groups (all optional) ---
# How long a group's invite code stays usable, in hours. A group code also registers an account,
# so a code that outlives the week it was shared in is a standing registration path on your server.
# Rotate (POST /v1/groups/{id}/invite/rotate) to issue a fresh code and a fresh window.
GROUP_INVITE_TTL_HOURS=168

# --- Recommendations (all optional) ---
# How often to ask the providers what is similar to the titles you rate highly. Generous by
# design: upstream similar-to lists change on the scale of weeks.
RECOMMENDATIONS_SEED_HOURS=12
# A backstop only. Rating, favouriting, finishing or removing a title invalidates your
# recommendations immediately; this covers the slow-moving inputs that have no cheap trigger.
RECOMMENDATIONS_TTL_HOURS=24
