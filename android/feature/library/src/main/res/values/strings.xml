<resources>
    <string name="library_title">Library</string>
    <string name="library_search_content_description">Search</string>

    <!-- The empty message differs by view: Home (no status picked, the sectioned grid) has no
         sections at all, so "Nothing in your library yet" is true there. A single-status view
         can be empty while the library is not, and that wording would read as data loss when the
         real answer is "nothing has this status" (library_empty_filtered).

         `:feature:favorites`'s `FavoritesScreenTest` (`the empty state shows the favourites copy,
         not the library copy`) keeps a LITERAL COPY of this exact string as a regression guard —
         it cannot import this module's `R` class (architecture rule 1 forbids a feature-to-
         feature dependency, even in test sources). If you reword this string, that test's
         snapshot goes stale silently: it keeps passing, just against wording nobody renders
         anymore. Reword `LIBRARY_EMPTY_DEFAULT_COPY` in that test file to match. -->
    <string name="library_empty_default">Nothing in your library yet</string>
    <string name="library_empty_filtered">Nothing here</string>
    <!-- Under library_empty_filtered: clears the status filter. -->
    <string name="library_empty_show_all">Show all</string>

    <!-- The row of Watching shows with an episode coming, at the top of "All shows". -->
    <string name="library_airing_soon">Airing soon</string>

    <string name="library_error_message">Couldn\'t load your library. Check your connection and try again.</string>

    <!-- A failed loadMore() (LibraryUiState.Success.pageError) — the already-loaded list stays on
         screen underneath this footer, so the copy is a small, tap-to-retry note rather than the
         full-screen library_error_message above. -->
    <string name="library_page_error">Couldn\'t load more. Tap to retry.</string>

    <!-- What TalkBack says for the two filter buttons, which on screen show only the bare choice
         ("Watching ▾", "Next episode ▾"). %1$s is that choice. -->
    <string name="library_status_description">Status: %1$s</string>
    <string name="library_sort_description">Sort: %1$s</string>
    <!-- The status button and menu entry for no status filter. -->
    <string name="library_status_all">All shows</string>
    <!-- At the end of the filter row: how many shows the current status filter holds. -->
    <plurals name="library_count">
        <item quantity="one">%d show</item>
        <item quantity="other">%d shows</item>
    </plurals>
    <string name="library_sort_title">Title</string>
    <string name="library_sort_score">Score</string>
    <string name="library_sort_next_episode">Next episode</string>

    <!-- Home: under a section holding more than three rows of posters. %1$d is how many shows the
         section holds. -->
    <string name="library_show_all">Show all %1$d</string>
    <string name="library_show_less">Show less</string>
    <!-- The pill on a caught-up poster: the show is waiting for its next season. %1$d is that
         season's number; "More soon" when no date is known yet. -->
    <string name="library_caught_up_season">S%1$d soon</string>
    <string name="library_caught_up_more">More soon</string>
</resources>
