    <string name="groups_join_submit">Join group</string>
    <string name="groups_join_submitting">Joining…</string>
    <string name="groups_join_cancel">Cancel</string>

    <!-- The invite-code card: shown ONLY in GroupsUiState.Success.justCreated, right after a
         create or join succeeds — the code is a credential the server withholds everywhere else
         (GET /v1/groups never returns one), so this copy only ever renders at that one moment. -->
    <string name="groups_invite_title">You\'re in %1$s</string>
    <string name="groups_invite_code_label">Invite code: %1$s</string>
    <string name="groups_invite_dismiss">Got it</string>

