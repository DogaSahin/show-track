<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        API 33+. Without it a posted notification is dropped SILENTLY — no exception, nothing in
        logcat — so episode alerts would be scheduled and simply never show. Declared in this
        module rather than in :app because this is the module that posts them; the manifest
        merger folds it into the app.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

</manifest>
