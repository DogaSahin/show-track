<?xml version="1.0" encoding="utf-8"?><!--
    Auto Backup rules for API 30 and BELOW. API 31+ reads data_extraction_rules.xml instead, so
    both files must carry the same exclusion or the gap is silent — minSdk here is 29, so this
    file is live, not legacy.

    https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!--
        The encrypted token store. Its AES-256/GCM key lives in the Android Keystore and does NOT
        travel with a backup by design, so a restored copy of this file can never be decrypted.
        Backing it up therefore buys nothing and costs two things: a credential-shaped blob in the
        user's cloud, and an undecryptable file that the app reads on every launch after a restore.

        The path is Context.preferencesDataStoreFile(name), i.e. filesDir/datastore/<name>.preferences_pb.
        TokenBackupExclusionTest asserts it against the name constant in :core:network.
    -->
    <exclude domain="file" path="datastore/showtrack_tokens.preferences_pb" />

    <!--
        Episode alerts: the switch and which alerts already fired. Both belong to this phone (the
        notification permission does not come back with a restore), so a copy is never useful.
    -->
    <exclude domain="file" path="datastore/showtrack_episode_alerts.preferences_pb" />
    <!--
        Recent searches: personal history, cleared at every sign-in anyway, so a cloud copy would
        only ever be a copy of someone's searches and never something a restore needs.
    -->
    <exclude domain="file" path="datastore/showtrack_recent_searches.preferences_pb" />
</full-backup-content>
